# Production Environment Variables
# Copy this file to .env.production and update the values

# Application
ENV=production
API_PORT=8080
LOG_LEVEL=info
LOG_PRETTY=false

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=consistency_service
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_SSL_MODE=disable

# Security
JWT_SECRET=your-jwt-secret-here-make-it-long-and-secure

# Optional: Redis (if using caching)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: External services
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
